# === DANE — nigdy nie wersjonowane ===
# Ticki Dukascopy to 10–50 GB. Dane są odtwarzalne z downloadera.
#
# UWAGA: ukośnik na POCZĄTKU kotwiczy wzorzec do korzenia repo.
# Samo "data/" ignorowałoby także src/data/ — czyli kod.
/data/
*.parquet
*.csv
*.bi5
*.gz

# === WYNIKI URUCHOMIEŃ ===
# Parquety przebiegu (trades, labels, null) bywają dziesiątkami MB i są
# odtwarzalne z kodu — zostają poza repo.
#
# Ale RAPORTY, metryki, kopia zamrożonej konfiguracji i diff brudnego
# drzewa to ~400 KB i są JEDYNYM dowodem wyniku. Ta sama logika, co przy
# trials.jsonl niżej: werdykt bez wersjonowanego raportu jest twierdzeniem,
# nie dowodem. Dotyczy to zwłaszcza bramki 2, która zakończyła projekt.
/runs/**
!/runs/**/
!/runs/**/*.md
!/runs/**/*.json
!/runs/**/*.yaml
!/runs/**/*.patch

# UWAGA: trials.jsonl NIE jest tu wymieniony celowo.
# Rejestr prób MUSI być wersjonowany — bez historii commitów
# licznik prób w Deflated Sharpe Ratio jest niewiarygodny.

# === PYTHON ===
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/

# === ŚRODOWISKO ===
.env
.DS_Store
.vscode/
.idea/
